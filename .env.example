# 对外访问域名。启用 HTTPS 后 COOKIE_SECURE 保持 true。
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=https://push.example.com
COOKIE_SECURE=true

# MySQL：先创建 webhook_mailer 数据库与专用账号。
MYSQL_DSN=webhook_user:replace-password@tcp(127.0.0.1:3306)/webhook_mailer?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai

# 登录管理后台的账号密码。ADMIN_TOKEN 为可选的脚本调用令牌。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN=replace-with-a-separate-long-random-token

# QQ SMTP 授权码仅保存在环境变量，后台页面不显示也不保存它。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-qq-number@qq.com
SMTP_PASSWORD=replace-with-a-new-qq-smtp-authorization-code
FROM_EMAIL=your-qq-number@qq.com
